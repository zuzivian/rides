{
  "name": "rides",
  "version": "0.1.0",
  "private": true,
  "description": "Your own rideshare history as stats, a map and a share card. Runs entirely in the browser.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p jsconfig.json",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist",
    "sample": "node scripts/gen-sample.mjs",
    "check": "npm test && npm run build"
  }
}
